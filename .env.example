# =============================================================================
# Configuration Google Maps Platform pour ZARÉN
# =============================================================================
# Remplacez MA_CLE_GOOGLE_MAPS par votre clé d'API Google Cloud Console
# Suivez les étapes de GOOGLE_MAPS_SETUP.md pour créer et restreindre votre clé.
# =============================================================================

NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=MA_CLE_GOOGLE_MAPS
VITE_GOOGLE_MAPS_API_KEY=MA_CLE_GOOGLE_MAPS

# Base de données PostgreSQL & Supabase
NEXT_PUBLIC_SUPABASE_URL=https://votre-projet.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=votre_cle_publique_anon_supabase
SUPABASE_SERVICE_ROLE_KEY=votre_cle_secrete_service_role
DATABASE_URL=postgresql://postgres:[VOTRE_MOT_DE_PASSE]@db.votre-projet.supabase.co:5432/postgres

# =============================================================================
# Configuration Google Maps Platform pour ZARÉN
# =============================================================================
# Remplacez MA_CLE_GOOGLE_MAPS par votre clé d'API Google Cloud Console
# Suivez les étapes de GOOGLE_MAPS_SETUP.md pour créer et restreindre votre clé.
# =============================================================================

NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=MA_CLE_GOOGLE_MAPS
VITE_GOOGLE_MAPS_API_KEY=MA_CLE_GOOGLE_MAPS

# Base de données PostgreSQL (Drizzle ORM)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/zaren_db

# ==============================================================================
# ZARÉN 2.0 — .gitignore Configuration
# ==============================================================================

# Dépendances Node.js
/node_modules
/.pnp
.pnp.js

# Build et cache Next.js
/.next/
/out/
/build
/dist
*.tsbuildinfo
next-env.d.ts

# Tests et Couverture
/coverage
*.lcov

# Variables d'environnement & Clés secrètes (Ne JAMAIS committer)
.env
.env*.local
.env.local
.env.development.local
.env.test.local
.env.production.local

# Déploiements & Cloud
.vercel
.turbo

# Fichiers journaux (Logs)
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*
*.log

# Caches d'éditeurs & OS
.DS_Store
Thumbs.db
*.pem
*.swp
*.swo
.idea/
.fleet/

# Supabase local (si utilisé)
/supabase/.branches
/supabase/.temp
